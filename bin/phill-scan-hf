#!/usr/bin/env php
<?php
require dirname(__DIR__) . '/bootstrap.php';

use Agent\HuggingFaceCatalog;

$args = array_slice($argv, 1);
$sort = null;
$limit = null;
$help = false;

for ($i = 0; $i < count($args); $i++) {
    $arg = $args[$i];
    if ($arg === '--help' || $arg === '-h') {
        $help = true;
    } elseif ($arg === '--sort' || $arg === '-s') {
        if (!isset($args[$i + 1])) {
            fwrite(STDERR, "Missing value for $arg\n");
            exit(2);
        }
        $sort = $args[++$i];
    } elseif ($arg === '--limit') {
        if (!isset($args[$i + 1])) {
            fwrite(STDERR, "Missing value for --limit\n");
            exit(2);
        }
        $limit = (int)$args[++$i];
    } else {
        fwrite(STDERR, "Unknown argument: $arg\n");
        exit(2);
    }
}

if ($help) {
    echo <<<EOT
Usage: phill-scan-hf [--sort KEY] [--limit N]

Prints the Hugging Face Hub model catalog as JSON on stdout.

Default: top-100 trending models (sort=trendingScore, direction=-1, limit=100).

--sort / -s KEY   Override sort; one of: author, downloads, downloadsAllTime, gated,
                  lastModified, likes, trendingScore, usedStorage.
--limit N         Page size (1..1000; default 100).
--help / -h       Show this help.

Diagnostics go to stderr; exit codes: 0 OK, 1 runtime/HTTP error, 2 usage error.
EOT;
    exit(0);
}

try {
    $catalog = new HuggingFaceCatalog();
    $models = $catalog->fetch($sort, $limit);
    echo json_encode($models, JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT) . "\n";
    exit(0);
} catch (\InvalidArgumentException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(2);
} catch (\RuntimeException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}
