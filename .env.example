APP_BIND=127.0.0.1
# Stable identity for persisted CLI agents; retain this value across container recreation.
APP_HOSTNAME=phillip
APP_PORT=8088
DB_PORT=15432
BROWSER_PORT=18082
SEARCH_PORT=18083
ATTACHMENT_MAX_BYTES=10485760
# -4 verbose, -3 debug, -2 info, -1 warning, 0 success, 1 error, 2 fatal; 3 disables a sink.
LOG_MIN_USER=-1
LOG_MIN_ADMIN=-2
LOG_MIN_CONSOLE=-3
LOG_MIN_FILE=-2
LOG_MIN_DATABASE=3
# LOG_FILE=/an/existing/private/log/directory/phillip.log
# Host CLI uses loopback; Compose overrides transport URLs with its private service names.
DB_DSN=pgsql:host=127.0.0.1;port=15432;dbname=phillip
DB_NAME=phillip
DB_USER=phillip
DB_PASSWORD=phillip_local_dev
PROFILE_JSON=config/profiles.local.json
CAMOUFOX_URL=http://127.0.0.1:18082
SEARXNG_URL=http://127.0.0.1:18083
SCAN_CIDRS=10.0.0.0/22
SCAN_PORTS=80,443,3000,5000,5001,8000,8001,8080,8081,8088,8888,9000,11434,1234
SCAN_CONCURRENCY=192
SCAN_TIMEOUT=0.6
BROWSER_TOKEN=phillip_local_browser_dev
